<< generate / http / xml / x-selection / clipboard
	test "${#}" -eq 0
	while true ; do
		printf -- '[--]\n' >&2
		curl \
				-i -s -f \
				-X POST \
				-H 'Content-Type: application/xml' \
				--data-binary @- \
				--retry 360 --retry-delay 1 --retry-connrefused \

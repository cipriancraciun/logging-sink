<< generate / http / text
	test "${#}" -eq 0
	while true ; do
		printf -- '[--]\n' >&2
		curl \
				-i -s -f \
				-X POST \
				-H 'Content-Type: text/plain' \
				--data-binary @- \
				--retry 360 --retry-delay 1 --retry-connrefused \
				-- http://127.35.195.99:8080/push \
			< <(
				printf -- '[~~]  message:  %s, %s, %s, %s!\n' "${RANDOM}" "${RANDOM}" "${RANDOM}" "${RANDOM}"
			) \
		#
		sleep -- 1s
	done
!!



#!/dev/null




::// examples / ...
::// watch / examples / ...
::// use / examples / ...








<< examples / exec
	exec -- "${ZRUN}" ':: run / exec' \
			\
			--input-syslog-parse-json true \
			--input-http-parse-json true \
			--input-mqtt-parse-json true \
			\
			--input-syslog-parse-xml true \
			--input-http-parse-xml true \
			--input-mqtt-parse-xml true \
			\
			--output-stdout-json-pretty true \
			\
			--input-mqtt-keep-alive 30s \
			--input-mqtt-clean-session true \
			--output-mqtt-keep-alive 30s \
			--output-mqtt-clean-session true \
			\
			--parser-message-raw false \
			\
			--report-interval 6s \
			\
			"${@}" \
	#
!!


<< examples / help
	exec -- "${ZRUN}" ':: examples / exec' --help "${@}"
!!

<< examples / version
	exec -- "${ZRUN}" ':: examples / exec' --version "${@}"
!!








<< examples / sink / from-syslog + to-stdout / rfc5424
	exec -- "${ZRUN}" ':: examples / exec' \
			--input-syslog-enabled true \
			--input-syslog-listen-udp "${_SYSLOG_INPUT_IP}:${_SYSLOG_INPUT_PORT}" \
			--input-syslog-protocol rfc5424 \
			--output-stdout-enabled true \
			"${@}" \
	#
!!



<< examples / listen / socat / from-syslog
	test "${#}" -eq 0
	exec -- socat \
			-u \
			udp-listen:"${_SYSLOG_INPUT_PORT}",bind="${_SYSLOG_INPUT_IP}",reuseaddr \
			stdout \
	#
!!


<< examples / listen / from-mqtt
	test "${#}" -eq 0
	exec -- mosquitto_sub \
			-h "${_MQTT_INPUT_IP}" -p "${_MQTT_INPUT_PORT}" -V 5 \
			-t "${_MQTT_INPUT_TOPIC}/#" -q 0 \
			-N -F '%t | id:%m size:%l qos:%q/%r | %p\n' \
	#
!!


<< examples / listen / to-mqtt
	test "${#}" -eq 0
	exec -- mosquitto_sub \
			-h "${_MQTT_OUTPUT_IP}" -p "${_MQTT_OUTPUT_PORT}" -V 5 \
			-t "${_MQTT_OUTPUT_TOPIC}/#" -q 0 \
			-N -F '%t | id:%m size:%l qos:%q/%r | %p\n' \
	#
!!








<< workspace / initialize / logs
	
	test "${#}" -eq 0
	
	if test -d ./.logs ; then
		exit -- 0
	fi
	
	test -d ./.outputs
	mkdir -- ./.outputs/logs
	mkdir -- ./.outputs/logs/current
	mkdir -- ./.outputs/logs/archived
	
	ln -s -f -T -- ./.outputs/logs ./.logs
!!



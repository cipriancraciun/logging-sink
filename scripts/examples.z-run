<< examples / generate / http / xml
	test "${#}" -eq 0
	while true ; do
		printf -- '[--]\n' >&2
		curl \
				-i -s -f \
				-X POST \
				-H 'Content-Type: application/xml' \
				--data-binary @- \
				--retry 360 --retry-delay 1 --retry-connrefused \
				-- "http://${_HTTP_INPUT_IP}:${_HTTP_INPUT_PORT}/${_HTTP_INPUT_PATH}" \
			< <(
				printf -- '<test> <a>%s</a> <b>%s</b> <c>%s</c> <d>%s</d> </test>\n' "${RANDOM}" "${RANDOM}" "${RANDOM}" "${RANDOM}"
			) \
		#
		sleep -- 1s
	done
!!








<< examples / generate / mqtt / text
	test "${#}" -eq 0
	exec -- mosquitto_pub \
			-h "${_MQTT_INPUT_IP}" -p "${_MQTT_OUTPUT_PORT}" -V 5 \
			-t "${_MQTT_INPUT_TOPIC}" -q 0 \
			-l \
		< <(
			while true ; do
				printf -- '[~~]  message:  %s %s %s %s!\n' "${RANDOM}" "${RANDOM}" "${RANDOM}" "${RANDOM}"
				sleep -- 1s
			done
		) \
	#

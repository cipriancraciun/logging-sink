<< examples / generate / syslog / text / rfc5424
	test "${#}" -eq 0
	exec -- logger \
			--udp --server="${_SYSLOG_INPUT_IP}" --port="${_SYSLOG_INPUT_PORT}" --size=65535 \
			--rfc5424 \
			--tag="tests" --msgid="msg-text-rfc5424" --id=959317 \
			--stderr \
		< <(
			while true ; do
				printf -- '[~~]  message:  %s %s %s %s!\n' "${RANDOM}" "${RANDOM}" "${RANDOM}" "${RANDOM}"
				sleep -- 1s
			done
		) \
	#
!!



<< examples / sink / from-mqtt + to-mqtt
	if test -z "${_MQTT_INPUT_TOPIC_IGNORE:-}" ; then
		_MQTT_INPUT_TOPIC_IGNORE='^'"${_MQTT_OUTPUT_TOPIC}"'(/?|$)'
	fi
	exec -- "${ZRUN}" ':: examples / exec' \
			--input-mqtt-enabled true \
			--input-mqtt-connect-tcp "${_MQTT_INPUT_IP}:${_MQTT_INPUT_PORT}" \
			--input-mqtt-client "${_MQTT_INPUT_CLIENT}" \
			--input-mqtt-topic "${_MQTT_INPUT_TOPIC}" \
			--input-mqtt-topic-ignore "${_MQTT_INPUT_TOPIC_IGNORE}" \
			--output-mqtt-enabled true \
			--output-mqtt-connect-tcp "${_MQTT_OUTPUT_IP}:${_MQTT_OUTPUT_PORT}" \
			--output-mqtt-client "${_MQTT_OUTPUT_CLIENT}" \
			--output-mqtt-topic "${_MQTT_OUTPUT_TOPIC}" \
			--output-mqtt-topic-suffix "${_MQTT_OUTPUT_TOPIC_SUFFIX}" \
			"${@}" \
	#
!!








<< examples / sink / from-syslog + to-file / rfc5424
	exec -- "${ZRUN}" ':: examples / exec' \
			--input-syslog-enabled true \
			--input-syslog-listen-udp "${_SYSLOG_INPUT_IP}:${_SYSLOG_INPUT_PORT}" \
			--input-syslog-protocol rfc5424 \
			--output-file-enabled true \
			--output-file-current-symlink "${_FILE_OUTPUT_LOGS}/tail" \
			--output-file-current-store "${_FILE_OUTPUT_LOGS}/current" \
			--output-file-archived-store "${_FILE_OUTPUT_LOGS}/archived" \
			--output-file-archived-compress "${_FILE_OUTPUT_COMPRESSION}" \
			--output-file-json-pretty false \
			--output-file-messages 100000 \
			--output-file-timeout 120s \
			"${@}" \
	#
!!


